<?xml version="1.0"?>
<package format="3">
  <name>arc_msgs</name>
  <version>0.0.0</version>
  <description>The car interface: messages and services the car backend and drivers publish and every platform node and experiment uses (ADR-0028, ADR-0047, ICD ros2-msgs).</description>
  <maintainer email="devlead@arcarleton.ca">ARC</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>
  <depend>std_msgs</depend>
  <exec_depend>rosidl_default_runtime</exec_depend>
  <member_of_group>rosidl_interface_packages</member_of_group>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
