<?xml version="1.0"?>
<!--
  Placeholder racecar for the ARC simulator (Gazebo Harmonic, ROS 2 Jazzy).

  Geometry comes from f1tenth_simulator's racecar.xacro (an RViz-only model), extended
  with inertia, collision, movable steering/wheel joints and the AckermannSteering plugin.
  The chassis visual is the OpenRC F1 STL, reduced; it does not match these dimensions.

  Values marked TBC are placeholders until the ARC car's CAD lands (systems/mechanical,
  layout-brief M2). Swap this file to swap the car.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="racecar">

  <!-- Geometry from racecar.xacro (Traxxas-based F1TENTH). TBC for the ARC car. -->
  <xacro:property name="wheelbase" value="0.3302"/>
  <xacro:property name="width" value="0.2032"/>
  <xacro:property name="height" value="0.1"/>
  <xacro:property name="ground_offset" value="0.04"/>
  <xacro:property name="wheel_radius" value="0.0508"/>
  <xacro:property name="wheel_length" value="0.0381"/>
  <xacro:property name="wheel_separation" value="${width + wheel_length}"/>

  <!-- Placeholder physics. TBC. -->
  <xacro:property name="chassis_mass" value="3.0"/>
  <xacro:property name="wheel_mass" value="0.1"/>
  <xacro:property name="hinge_mass" value="0.05"/>
  <!-- F1TENTH gym's max steering angle (rad). -->
  <xacro:property name="steering_limit" value="0.4189"/>

  <!-- 2D LiDAR, E-10 (Hokuyo UST-10LX, ADR-0001). Settings come from simulator/.env through the
       container's environment; the defaults here match E-10 for runs without it. -->
  <xacro:property name="lidar_rate" value="$(optenv LIDAR_RATE 40)"/>
  <xacro:property name="lidar_samples" value="$(optenv LIDAR_SAMPLES 1081)"/>
  <xacro:property name="lidar_fov_deg" value="$(optenv LIDAR_FOV_DEG 270)"/>
  <xacro:property name="lidar_range_min" value="$(optenv LIDAR_RANGE_MIN 0.06)"/>
  <xacro:property name="lidar_range_max" value="$(optenv LIDAR_RANGE_MAX 10)"/>
  <!-- Mount pose, base_link frame: front of the chassis, centred, above the body. TBC until the
       ARC CAD places it (systems/mechanical, layout-brief M2). -->
  <xacro:property name="lidar_x" value="0.265"/>
  <xacro:property name="lidar_z" value="${ground_offset + height + 0.03}"/>

  <!-- IMU, E-20 (ST ISM330DHCX, at the CG). Samples every physics step (1 ms, worlds/empty.sdf); the
       part's >= 4 kHz isn't simulated, since Gazebo can't produce new data faster than it steps.
       Its ranges (IMU_ACCEL_RANGE_G, IMU_GYRO_RANGE_DPS in simulator/.env) are read by the bridge. -->
  <xacro:property name="imu_rate" value="$(optenv IMU_RATE 1000)"/>

  <!-- base_link sits on the ground under the rear axle, as in racecar.xacro. -->
  <link name="base_link"/>

  <link name="chassis">
    <inertial>
      <origin xyz="${wheelbase/2} 0 ${ground_offset + height/2}"/>
      <mass value="${chassis_mass}"/>
      <inertia ixx="${chassis_mass/12*(width*width + height*height)}" ixy="0" ixz="0"
               iyy="${chassis_mass/12*(wheelbase*wheelbase + height*height)}" iyz="0"
               izz="${chassis_mass/12*(wheelbase*wheelbase + width*width)}"/>
    </inertial>
    <visual>
      <geometry>
        <mesh filename="package://arc_sim/meshes/chassis.stl"/>
      </geometry>
    </visual>
    <collision>
      <origin xyz="${wheelbase/2} 0 ${ground_offset + height/2}"/>
      <geometry>
        <box size="${wheelbase} ${width} ${height}"/>
      </geometry>
    </collision>
  </link>

  <joint name="base_to_chassis" type="fixed">
    <parent link="base_link"/>
    <child link="chassis"/>
  </joint>

  <!-- A wheel spinning about its y axis. Cylinder geometry is along z, so roll it onto y. -->
  <xacro:macro name="wheel" params="name">
    <link name="${name}_wheel">
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="${wheel_mass/12*(3*wheel_radius*wheel_radius + wheel_length*wheel_length)}" ixy="0" ixz="0"
                 iyy="${wheel_mass/2*wheel_radius*wheel_radius}" iyz="0"
                 izz="${wheel_mass/12*(3*wheel_radius*wheel_radius + wheel_length*wheel_length)}"/>
      </inertial>
      <visual>
        <origin rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_length}"/>
        </geometry>
      </collision>
    </link>
  </xacro:macro>

  <!-- Rear wheels: driven, not steered. -->
  <xacro:macro name="rear_wheel" params="side y">
    <xacro:wheel name="rear_${side}"/>
    <joint name="rear_${side}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="rear_${side}_wheel"/>
      <origin xyz="0 ${y} ${wheel_radius}"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <!-- Front wheels: a steering hinge (revolute about z), then a driven wheel. -->
  <xacro:macro name="front_wheel" params="side y">
    <link name="front_${side}_hinge">
      <inertial>
        <mass value="${hinge_mass}"/>
        <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
      </inertial>
    </link>
    <joint name="front_${side}_steering_joint" type="revolute">
      <parent link="base_link"/>
      <child link="front_${side}_hinge"/>
      <origin xyz="${wheelbase} ${y} ${wheel_radius}"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-steering_limit}" upper="${steering_limit}" effort="10" velocity="5"/>
    </joint>
    <xacro:wheel name="front_${side}"/>
    <joint name="front_${side}_wheel_joint" type="continuous">
      <parent link="front_${side}_hinge"/>
      <child link="front_${side}_wheel"/>
      <axis xyz="0 1 0"/>
    </joint>
  </xacro:macro>

  <xacro:rear_wheel side="left" y="${wheel_separation/2}"/>
  <xacro:rear_wheel side="right" y="${-wheel_separation/2}"/>
  <xacro:front_wheel side="left" y="${wheel_separation/2}"/>
  <xacro:front_wheel side="right" y="${-wheel_separation/2}"/>

  <!-- LiDAR: scans in the plane of its link, x forward, angles counter-clockwise from x. -->
  <link name="lidar"/>
  <joint name="base_to_lidar" type="fixed">
    <parent link="base_link"/>
    <child link="lidar"/>
    <origin xyz="${lidar_x} 0 ${lidar_z}"/>
  </joint>
  <!-- Gazebo renders it only while something subscribes to its topic (the Sensors system skips
       sensors without subscribers), so a lazy chain up to the ground station turns it off. -->
  <gazebo reference="lidar">
    <sensor name="lidar" type="gpu_lidar">
      <topic>/model/racecar/scan</topic>
      <gz_frame_id>lidar</gz_frame_id>
      <update_rate>${lidar_rate}</update_rate>
      <always_on>true</always_on>
      <lidar>
        <scan>
          <horizontal>
            <samples>${lidar_samples}</samples>
            <resolution>1</resolution>
            <min_angle>${-radians(lidar_fov_deg) / 2}</min_angle>
            <max_angle>${radians(lidar_fov_deg) / 2}</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>${lidar_range_min}</min>
          <max>${lidar_range_max}</max>
          <resolution>0.001</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <!-- IMU at the chassis centre of mass (E-20 sits at the CG), axes aligned with base_link. Each IMU
       publishes /model/racecar/imu/<name>; config/bridge.yaml carries it to /sim/imu/<name> and
       imu_noise.py to /imu/<name>, which the ground station finds by name. TBC until the ARC CAD
       places it. -->
  <link name="imu_cg"/>
  <joint name="base_to_imu_cg" type="fixed">
    <parent link="base_link"/>
    <child link="imu_cg"/>
    <origin xyz="${wheelbase/2} 0 ${ground_offset + height/2}"/>
  </joint>
  <gazebo reference="imu_cg">
    <sensor name="imu_cg" type="imu">
      <topic>/model/racecar/imu/cg</topic>
      <gz_frame_id>imu_cg</gz_frame_id>
      <update_rate>${imu_rate}</update_rate>
      <always_on>true</always_on>
    </sensor>
  </gazebo>

  <!--
    Gazebo's built-in Ackermann controller. Input is a Twist (speed + yaw rate), not
    AckermannDriveStamped; converting /drive is outside the sim. All four wheels are
    driven (the ARC car is 4WD, ADR-0026).
  -->
  <gazebo>
    <plugin filename="gz-sim-ackermann-steering-system" name="gz::sim::systems::AckermannSteering">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>rear_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>rear_right_wheel_joint</right_joint>
      <left_steering_joint>front_left_steering_joint</left_steering_joint>
      <right_steering_joint>front_right_steering_joint</right_steering_joint>
      <kingpin_width>${wheel_separation}</kingpin_width>
      <steering_limit>${steering_limit}</steering_limit>
      <wheel_base>${wheelbase}</wheel_base>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <topic>/model/racecar/cmd_vel</topic>
      <odom_topic>/model/racecar/odometry</odom_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
    </plugin>
    <!-- Ground truth: the car's actual world pose, for the viewer and for scoring later.
         Internal only; the algorithm must never subscribe to it. -->
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/model/racecar/ground_truth</odom_topic>
      <tf_topic>/model/racecar/ground_truth/tf</tf_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </gazebo>

</robot>
