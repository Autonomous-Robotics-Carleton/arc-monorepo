# Simulated sensor settings, read by run.sh (docker run --env-file) and used by the car model
# (src/arc_sim/urdf/racecar.urdf.xacro). Changes take effect on the next ./run.sh.
# Defaults follow systems/bom/electrical.md; systems/ wins if they disagree.

# 2D LiDAR, E-10: Hokuyo UST-10LX (ADR-0001). 40 Hz, 0.25 deg over 270 deg, 10 m.
LIDAR_RATE=40
LIDAR_SAMPLES=1081
LIDAR_FOV_DEG=270
# Minimum range is TBC (not in E-10).
LIDAR_RANGE_MIN=0.06
LIDAR_RANGE_MAX=10

# IMU, E-20: ST ISM330DHCX at the CG. Sampled every physics step (1 ms); the part's >= 4 kHz isn't
# simulated (see README, Sensors). Ranges are the BOM's TBC settings; the ground station flags samples
# at the range as saturated.
IMU_RATE=1000
IMU_ACCEL_RANGE_G=16
IMU_GYRO_RANGE_DPS=2000

# Noise, global: meant for every sensor's noise model; only the wheel encoders read it so far.
# SENSOR_NOISE_SCALE multiplies each sensor's datasheet baseline (0 = no noise). SENSOR_FAIL_PROB is
# the chance per sample per sensor of a failed read, which is dropped. SENSOR_SEED (int) makes a run
# repeatable; empty draws a new seed each run.
SENSOR_NOISE_SCALE=1.0
SENSOR_FAIL_PROB=0.1
SENSOR_SEED=

# Wheel encoders, E-22: AS5047P, 14-bit absolute, one per wheel. Sampled every physics step (1 ms);
# the car reads them at 2 kHz (systems/architecture.md). Baselines for the noise model, 1 sigma jitter
# and peak nonlinearity, from the AS5047P datasheet v2-00 (Figure 8): ONL 0.068 deg rms max, INL +-0.8 deg
# max (magnet in the optimum position, 25 C). The datasheet gives no error shape; the 1x + 2x sine is ours.
ENCODER_JITTER_DEG=0.068
ENCODER_NONLINEARITY_DEG=0.8
