# Simulated sensor settings, read by run.sh (docker run --env-file) and used by the car model
# (src/arc_sim/urdf/racecar.urdf.xacro). Changes take effect on the next ./run.sh.
# Defaults follow systems/bom/electrical.md; systems/ wins if they disagree.

# 2D LiDAR, E-10: Hokuyo UST-10LX (ADR-0001). 40 Hz, 0.25 deg over 270 deg, 10 m.
LIDAR_RATE=40
LIDAR_SAMPLES=1081
LIDAR_FOV_DEG=270
# Minimum range is TBC (not in E-10).
LIDAR_RANGE_MIN=0.06
LIDAR_RANGE_MAX=10
