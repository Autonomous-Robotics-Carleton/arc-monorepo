# Large binaries from CAD and board design go through git LFS (`git lfs install` once).
hardware/**/*.step filter=lfs diff=lfs merge=lfs -text
hardware/**/*.stp  filter=lfs diff=lfs merge=lfs -text
hardware/**/*.pdf  filter=lfs diff=lfs merge=lfs -text
hardware/**/*.zip  filter=lfs diff=lfs merge=lfs -text
