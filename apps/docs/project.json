{
  "name": "docs",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/docs",
  "projectType": "application",
  "implicitDependencies": ["systems"],
  "targets": {
    "dev": {
      "command": "next dev --turbo",
      "options": {
        "cwd": "apps/docs"
      }
    },
    "build": {
      "command": "next build",
      "options": {
        "cwd": "apps/docs"
      },
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.github/CONTRIBUTING.md",
        "{workspaceRoot}/platform/dev-kit/**/*",
        "{workspaceRoot}/apps/web/docs/**/*",
        "{workspaceRoot}/ros/README.md",
        "{workspaceRoot}/firmware/README.md",
        "{workspaceRoot}/firmware/*/README.md",
        "{workspaceRoot}/tools/README.md",
        "{workspaceRoot}/libs/*/README.md",
        "{workspaceRoot}/platform/README.md",
        "{workspaceRoot}/experiments/README.md",
        "{workspaceRoot}/**/project.json"
      ],
      "outputs": ["{projectRoot}/.next"]
    },
    "start": {
      "command": "next start",
      "options": {
        "cwd": "apps/docs"
      },
      "dependsOn": ["build"]
    },
    "lint": {
      "command": "eslint .",
      "options": {
        "cwd": "apps/docs"
      }
    }
  }
}
