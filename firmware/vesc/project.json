{
  "name": "vesc",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "tags": ["env:dev-container"],
  "implicitDependencies": ["systems"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "make -C firmware/vesc/bldc -j$(nproc) fw_a50s_v23c_12s"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          "cmake -S firmware/vesc/arc -B firmware/vesc/build/arc",
          "cmake --build firmware/vesc/build/arc",
          "ctest --test-dir firmware/vesc/build/arc --output-on-failure",
          "cmake -S firmware/vesc/arc -B firmware/vesc/build/arc-coverage -DARC_SANITIZE=OFF -DARC_COVERAGE=ON",
          "cmake --build firmware/vesc/build/arc-coverage",
          "find firmware/vesc/build/arc-coverage -name '*.gcda' -delete",
          "ctest --test-dir firmware/vesc/build/arc-coverage",
          "gcovr -r firmware/vesc/arc --object-directory firmware/vesc/build/arc-coverage --filter firmware/vesc/arc/src/ --fail-under-line 100 --fail-under-branch 100 --print-summary"
        ],
        "parallel": false
      }
    }
  }
}
